# Plantilla de configuración de JeroSmart Activos.
# Copiar como `.env` y rellenar con valores reales. El `.env` NUNCA se versiona.
#   cp .env.example .env

# --- Base de datos (MySQL únicamente) ---
# Usar un usuario dedicado con permisos solo sobre esta base, NO root.
#   CREATE USER 'jerosmart'@'localhost' IDENTIFIED BY '<password-fuerte>';
#   GRANT ALL PRIVILEGES ON jerosmart_activos.* TO 'jerosmart'@'localhost';
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=jerosmart
DB_PASSWORD=
DB_NAME=jerosmart_activos

# --- Seguridad ---
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Poner en True SOLO si la app corre detrás de un proxy inverso confiable (nginx/IIS/ELB)
TRUST_X_FORWARDED_FOR=False

# --- Email (SMTP) ---
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
SUPERVISOR_EMAIL=

# --- Caché de PDFs ---
PDF_CACHE_ENABLED=True
PDF_CACHE_MAX_AGE_DAYS=30
